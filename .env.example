# Required
GITHUB_TOKEN=ghp_your_token_here
ENTERPRISE_SLUG=your-enterprise-slug

# Optional but recommended. Falls back to GITHUB_TOKEN when omitted.
# EMU: classic PAT with scim:enterprise (or admin:enterprise for read-only GETs).
# Organization SCIM: classic PAT with admin:org, authorized for SAML SSO.
# SCIM_TOKEN=ghp_your_scim_token_here

# Authoritative Entra ID export created by `npm run export:entra`
ENTRA_USERS_FILE=./input/entra-users.json

# GitHub.com defaults
GRAPHQL_URL=https://api.github.com/graphql
API_BASE_URL=https://api.github.com

# For GitHub Enterprise Server, replace the endpoints below:
# GRAPHQL_URL=https://github.example.com/api/graphql
# API_BASE_URL=https://github.example.com/api/v3

# Output
OUTPUT_FORMAT=csv
OUTPUT_FILE=./output/users.csv

# Export only users with ExternalIdentity + Copilot seat + org membership
FILTER_STRICT=false
